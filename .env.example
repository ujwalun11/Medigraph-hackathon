# FalkorDB Configuration
FALKORDB_HOST=localhost
FALKORDB_PORT=6379
FALKORDB_GRAPH_NAME=clinical_graph

# LLM Configuration
LLM_BACKEND=gemini
GOOGLE_API_KEY=your_gemini_api_key_here
AGENT_MODEL=gemini-2.0-flash

# Ollama Fallback (if LLM_BACKEND=ollama)
OLLAMA_BASE_URL=http://localhost:11434
LLM_MODEL=qwen2.5-coder:7b

# Server Ports
API_PORT=8008
MCP_PORT=8010

# LangSmith Observability & Agent Tracing (Optional)
# Set to "true" and add your key from smith.langchain.com
LANGCHAIN_TRACING_V2=false
LANGCHAIN_ENDPOINT=https://api.smith.langchain.com
LANGCHAIN_API_KEY=your_langsmith_api_key_here
LANGCHAIN_PROJECT=medigraph-falkordb
